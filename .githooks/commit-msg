#!/bin/bash

COMMIT_MSG_FILE=$1
FIRST_LINE=$(head -n1 "$COMMIT_MSG_FILE")

PATTERN="^(feat|fix|refactor|docs|test|chore|style): .+"

if [[ ! $FIRST_LINE =~ $PATTERN ]]; then
  echo "========================================================="
  echo "🚨 잘못된 커밋 메시지 양식입니다!"
  echo "========================================================="
  echo "  feat: 새 기능"
  echo "  fix: 버그 수정"
  echo "  refactor: 기능 변화 없는 구조 개선"
  echo "  docs: 문서 수정"
  echo "  test: 테스트 코드"
  echo "  chore: 설정/빌드/잡일"
  echo "  style: 포맷/세미콜론 등 로직 변화 없음"
  echo "========================================================="
  echo "작성하신 메시지: \"$FIRST_LINE\""
  echo "========================================================="
  exit 1
fi
exit 0