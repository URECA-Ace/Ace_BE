{
  "id": null,
  "uid": "ace-coupon-metrics",
  "title": "Ace Coupon Metrics",
  "tags": ["ace", "coupon"],
  "timezone": "browser",
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "쿠폰 발급 현황 (성공/실패)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(coupon_issue_total{result=\"success\"}[$__rate_interval]))",
          "legendFormat": "success"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(coupon_issue_total{result=\"fail\"}[$__rate_interval]))",
          "legendFormat": "fail"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "쿠폰 발급 실패 사유별",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (reason) (rate(coupon_issue_total{result=\"fail\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "쿠폰 상태 변경 현황 (전이별)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (from, to) (rate(coupon_state_change_total{result=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{from}} -> {{to}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "쿠폰 상태 변경 실패 사유별",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (reason) (rate(coupon_state_change_total{result=\"fail\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "정합성 검증 현황 (체크/상태)",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (check, status) (rate(consistency_verification_total[$__rate_interval]))",
          "legendFormat": "{{check}} - {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "RELAY 비동기 저장 결과 (RELAY 모드 전환 대비)",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(coupon_issue_relay_total{result=\"success\"}[$__rate_interval]))",
          "legendFormat": "success"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (reason) (rate(coupon_issue_relay_total{result=\"fail\"}[$__rate_interval]))",
          "legendFormat": "fail - {{reason}}"
        }
      ]
    }
  ]
}
